# OpsFleet environment template.
# Copy to .env and fill in the values:  cp .env.example .env
# .env is ignored by Git. Never commit real keys or passwords.

# --- Google Cloud / BigQuery ---------------------------------------------------
# BigQuery authenticates with Application Default Credentials, not a key in this file:
#   gcloud auth application-default login
# Leave GOOGLE_APPLICATION_CREDENTIALS unset unless it points to a real key file.
PROJECT_NAME=your-gcp-project-name
PROJECT_ID=your-gcp-project-id
DATASET_ID=bigquery-public-data.thelook_ecommerce

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL_1 is the CLI default model (--model overrides it).
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_MODEL_2=gemini-3.6-flash

# --- PostgreSQL installation superuser -------------------------------------------
# Used ONLY by `uv run python -m scripts.setup_datachatdb` to create the datachatdb
# roles and databases. The application never uses these credentials.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PWD=your-postgres-superuser-password

# --- datachatdb (report library) -------------------------------------------------
# Leave this block commented out. `scripts.setup_datachatdb` appends it to .env with a
# freshly generated DATACHAT_DB_PASSWORD. Uncomment it only to connect to an existing
# datachatdb whose password you already know (a placeholder password here would be used
# as the real one). `scripts.make_docker_secrets` copies the passwords into ./secrets/.
# DATACHAT_DB_HOST=localhost
# DATACHAT_DB_PORT=5432
# DATACHAT_DB_NAME=datachatdb
# DATACHAT_TEST_DB_NAME=datachatdb_test
# DATACHAT_DB_USER=datachat_app
# DATACHAT_DB_PASSWORD=
# DATACHAT_DB_ADMIN_USER=admindb
# DATACHAT_DB_ADMIN_PASSWORD=postgres

# --- Optional -------------------------------------------------------------------
# Default --grants file for main.py (the Docker image sets this to the executives' grants).
# DATACHAT_GRANTS_FILE=config/grants.executives.json
